    "#@title 🚀 Cell 1: Khởi Tạo Môi Trường & Smart Google Drive Setup { vertical-output: true }\n",
    "#@markdown Nhấn nút Run để kết nối Google Drive, khởi tạo thư mục chuẩn hóa và cài đặt môi trường.\n",
    "\n",
    "import os\n",
    "import sys\n",
    "\n",
    "# 1. Clone / Pull Repository từ GitHub\n",
    "REPO_URL = \"https://github.com/nguyenducvuongg/LorasTrainning.git\" #@param {type:\"string\"}\n",
    "WORKSPACE_DIR = \"/content/LorasTrainning\"\n",
    "\n",
    "if not os.path.exists(WORKSPACE_DIR):\n",
    "    print(f\"📦 Cloning repository from {REPO_URL}...\")\n",
    "    !git clone {REPO_URL} {WORKSPACE_DIR}\n",
    "else:\n",
    "    print(f\"🔄 Updating repository in {WORKSPACE_DIR}...\")\n",
    "    !git -C {WORKSPACE_DIR} pull || true\n",
    "\n",
    "%cd {WORKSPACE_DIR}\n",
    "if \"src\" not in sys.path:\n",
    "    sys.path.insert(0, os.path.join(WORKSPACE_DIR, \"src\"))\n",
    "\n",
    "# 2. Cài đặt các thư viện cần thiết\n",
    "print(\"⚡ Cài đặt dependencies...\")\n",
    "!pip install -q --upgrade pip setuptools wheel\n",
    "!pip install -q accelerate transformers diffusers peft safetensors huggingface-hub bitsandbytes rich pyyaml toml google-genai openai\n",
    "!pip install -q -e .\n",
    "\n",
    "# 3. Mount Google Drive & Khởi tạo cây thư mục chuẩn (Chống ghi đè)\n",
    "from lora_colab.storage.gdrive_manager import GDriveWorkspaceManager\n",
    "GDriveWorkspaceManager.mount_google_drive()\n",
    "DRIVE_PATHS = GDriveWorkspaceManager.init_workspace()\n",
    "print(\"\\n✅ Cell 1 hoàn thành thành công!\")"
   ]
